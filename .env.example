# Environment variables for HoldIt
#
# Expo loads env files in this order (later files override earlier ones):
#   .env
#   .env.local                        ← gitignored; your machine-specific overrides
#   .env.development / .env.production
#   .env.development.local / .env.production.local  ← gitignored; secrets per environment
#
# Only EXPO_PUBLIC_* vars are embedded in the app bundle.
# Run `supabase start` before developing against local Supabase.

# ── Local development (defaults in .env.development) ──────────────────────────
# iOS Simulator / web:
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Android Emulator — put this in .env.local instead:
# EXPO_PUBLIC_SUPABASE_URL=http://10.0.2.2:54321
# Physical device — use your machine's LAN IP:
# EXPO_PUBLIC_SUPABASE_URL=http://192.168.x.x:54321

# Standard local anon key (same for every `supabase init` project)
EXPO_PUBLIC_SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# ── Production (copy to .env.production.local or set as EAS Secrets) ──────────
# EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# EXPO_PUBLIC_SUPABASE_KEY=your-publishable-key

# ── Server-side only (not bundled; use in API routes / Edge Functions) ───────
# GEMINI_API_KEY=
